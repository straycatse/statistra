      "_type": "request",
      "parentId": "fld_ingest",
      "name": "Ingest event",
      "description": "eventType is the only required field. occurredAt defaults to now and may be\nbackdated to backfill history; eventId is generated server-side if omitted.",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/v1/events",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"eventType\": \"page_view\",\n  \"metadata\": {\n    \"plan\": \"pro\",\n    \"country\": \"SE\"\n  }\n}"
