    {
      "_id": "wrk_statistra",
      "_type": "workspace",
      "parentId": null,
      "name": "Statistra API",
      "description": "Multi-tenant analytics ingest and query API.\n\nAuth is two separate schemes:\n  - Tenant endpoints (/api/**) use the X-API-Key header.\n  - Operator endpoints (/admin/**, /actuator/* except health) use a Bearer ADMIN_TOKEN.\n\nA tenant key never grants operator access, and no query endpoint accepts an\norganization id: scope comes from the key, so there is no request you can\nconstruct that reads another tenant's data.\n\nPick an environment (Local or Railway) before sending anything.\nRun 'Create organization' first, then paste the returned apiKey into the\nenvironment: it is shown exactly once and cannot be recovered.",
      "scope": "collection"
    },
    {
      "_id": "env_base",
      "_type": "environment",
      "parentId": "wrk_statistra",
      "name": "Base Environment",
      "data": {
        "baseUrl": "http://localhost:8080",
        "apiKey": "",
        "adminToken": "",
        "orgId": "1"
      },
      "dataPropertyOrder": {
        "&": [
          "baseUrl",
          "apiKey",
          "adminToken",
          "orgId"
        ]
      },
      "metaSortKey": 1,
      "isPrivate": false
    },
    {
      "_id": "env_local",
