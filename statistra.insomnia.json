    {
      "_id": "req_org_rotate",
      "_type": "request",
      "parentId": "fld_admin",
      "name": "Rotate API key (see warning)",
      "description": "Issues a replacement key and invalidates the old one immediately.\n\nWARNING: orgId defaults to 1, and on a local stack organization 1 is the\nseeded 'Local Development' org. Rotating it invalidates\nst_dev_local_key_not_for_production, after which every other request in\nthis collection returns 401 with no hint as to why.\n\nRestarting the app re-seeds the dev org and restores that key. Against a\nreal deployment, set orgId to the organization you actually mean and copy\nthe returned apiKey into the environment: the old one stops working at once.",
      "method": "POST",
      "url": "{{ _.baseUrl }}/admin/organizations/{{ _.orgId }}/rotate-key",
      "body": {},
      "parameters": [],
      "headers": [],
      "authentication": {
        "type": "bearer",
        "token": "{{ _.adminToken }}"
      },
      "metaSortKey": -4,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
    {
      "_id": "fld_ingest",
      "_type": "request_group",
      "parentId": "wrk_statistra",
      "name": "2. Ingest",
      "description": "Returns 202 Accepted: the event is published to Kafka and persisted\nasynchronously, so a 202 means accepted, not yet stored. Use the Analytics\nfolder to confirm it landed.\n\norganizationId is never accepted from the body. It comes from the API key.",
      "environment": {},
      "environmentPropertyOrder": null,
      "metaSortKey": -5
    },
    {
