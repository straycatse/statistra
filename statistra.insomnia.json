      "_type": "request_group",
      "parentId": "wrk_statistra",
      "name": "1. Admin (operator)",
      "description": "Guarded by Bearer ADMIN_TOKEN, separate from tenant keys because minting\ncredentials must not be reachable with a tenant credential.\n\nIf ADMIN_TOKEN is unset the API answers 503 rather than running open.",
      "environment": {},
      "environmentPropertyOrder": null,
      "metaSortKey": -1
    },
    {
      "_id": "req_org_create",
      "_type": "request",
      "parentId": "fld_admin",
      "name": "Create organization",
      "description": "Returns the plaintext apiKey ONCE. It is stored only as a SHA-256 hash and\ncannot be recovered, only replaced via rotate-key. Copy it into the\nenvironment's apiKey variable.",
      "method": "POST",
      "url": "{{ _.baseUrl }}/admin/organizations",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Acme Inc\"\n}"
      },
      "parameters": [],
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {
        "type": "bearer",
        "token": "{{ _.adminToken }}"
      },
