    {
      "_id": "req_ingest_idem",
      "_type": "request",
      "parentId": "fld_ingest",
      "name": "Ingest event (fixed eventId, idempotent)",
      "description": "Send this twice. The count must not change.\n\nKafka delivers at least once, so a UNIQUE (organization_id, event_id)\nconstraint plus INSERT ... ON CONFLICT DO NOTHING is what stops redeliveries\nand client retries from inflating every metric.",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/v1/events",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"eventId\": \"11111111-2222-3333-4444-555555555555\",\n  \"eventType\": \"signup\",\n  \"occurredAt\": \"2026-08-13T10:00:00Z\",\n  \"metadata\": {\n    \"plan\": \"free\"\n  }\n}"
      },
      "parameters": [],
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "X-API-Key",
          "value": "{{ _.apiKey }}"
